# Nenhum destes valores é usado como está - este arquivo só documenta os
# NOMES das variáveis de ambiente. Nunca coloque valores reais aqui nem em
# nenhum arquivo versionado no Git. Copie para ".env" (já ignorado pelo
# Git) ou configure direto no ambiente/serviço de hospedagem.

# ---- Servidor ----
# Porta HTTP do servidor (padrão: 3000)
PORT=
# Marca o cookie de sessão como "Secure" (exigido quando o sistema estiver
# atrás de HTTPS - deixe vazio/0 em rede local sem HTTPS)
COOKIE_SECURE=
# Caminhos para certificado/chave TLS. Se os dois forem informados, o
# próprio processo passa a servir HTTPS diretamente (sem precisar de um
# proxy reverso na frente). Deixe vazio em rede local ou quando o HTTPS
# já for terminado por um proxy reverso (nginx/caddy) antes deste servidor
# - lembre de então também definir COOKIE_SECURE=1.
TLS_CERT_PATH=
TLS_KEY_PATH=

# ---- Central de Fotos ----
CENTRAL_FOTOS_DIR=
CENTRAL_FOTOS_MAX_FILE_MB=
CENTRAL_FOTOS_MAX_DIMENSAO_PX=
CENTRAL_FOTOS_MAX_FOTOS_POR_PRODUTO=
CENTRAL_FOTOS_MAX_ARQUIVOS_POR_ENVIO=
CENTRAL_FOTOS_CACHE_TTL_MS=
CENTRAL_FOTOS_LIXEIRA_DIAS=
# Token fixo para outro serviço/processo consultar fotos sem sessão de
# usuário (cabeçalho x-service-token) - gere um valor aleatório longo.
CENTRAL_FOTOS_SERVICE_TOKEN=

# ---- Marketplace: geral ----
# Intervalo (em milissegundos) do ciclo de sincronização/reconciliação
# periódica e de reprocessamento da fila de falhas (padrão: 300000 = 5min)
MARKETPLACE_SYNC_INTERVAL_MS=
# Limites da captura de tela do pedido manual (OCR)
MARKETPLACE_CAPTURE_MAX_FILE_MB=
MARKETPLACE_CAPTURE_MAX_DIMENSAO_PX=
# Dias até uma captura de tela processada ser apagada automaticamente
MARKETPLACE_CAPTURE_RETENCAO_DIAS=
# URL pública base do sistema, usada para montar callbacks/webhooks quando
# o sistema estiver hospedado com HTTPS (Fase 2/3 - deixe vazio enquanto
# rodar só localmente pelo IP, sem endereço público)
MARKETPLACE_BASE_URL=

# ---- Mercado Livre (Fase 2 - ainda não usado nesta fase) ----
# Uma credencial por loja conectada. O nome de cada variável é livre - o
# que a loja guarda em "credencial_ref" (cadastro da loja no módulo
# Marketplace) é só o NOME da variável correspondente, nunca o valor.
# Exemplo para 3 lojas do Mercado Livre:
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
MERCADOLIVRE_LOJA1_ACCESS_TOKEN=
MERCADOLIVRE_LOJA1_REFRESH_TOKEN=
MERCADOLIVRE_LOJA2_ACCESS_TOKEN=
MERCADOLIVRE_LOJA2_REFRESH_TOKEN=
MERCADOLIVRE_LOJA3_ACCESS_TOKEN=
MERCADOLIVRE_LOJA3_REFRESH_TOKEN=

# ---- Shopee (Fase 3 - ainda não usado nesta fase) ----
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
SHOPEE_LOJA1_SHOP_ID=
SHOPEE_LOJA1_ACCESS_TOKEN=
SHOPEE_LOJA1_REFRESH_TOKEN=
SHOPEE_LOJA2_SHOP_ID=
SHOPEE_LOJA2_ACCESS_TOKEN=
SHOPEE_LOJA2_REFRESH_TOKEN=
SHOPEE_LOJA3_SHOP_ID=
SHOPEE_LOJA3_ACCESS_TOKEN=
SHOPEE_LOJA3_REFRESH_TOKEN=
